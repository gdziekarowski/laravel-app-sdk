{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Inter, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "fontSize": "15px",
    "background": "#ffffff",
    "primaryColor": "#eef2ff",
    "primaryBorderColor": "#818cf8",
    "primaryTextColor": "#1e1b4b",
    "secondaryColor": "#ecfdf5",
    "secondaryBorderColor": "#34d399",
    "secondaryTextColor": "#064e3b",
    "tertiaryColor": "#f8fafc",
    "tertiaryBorderColor": "#e2e8f0",
    "tertiaryTextColor": "#0f172a",
    "lineColor": "#94a3b8",
    "textColor": "#0f172a",
    "clusterBkg": "#f8fafc",
    "clusterBorder": "#e2e8f0",
    "edgeLabelBackground": "#ffffff",
    "actorBkg": "#4f46e5",
    "actorBorder": "#4338ca",
    "actorTextColor": "#ffffff",
    "actorLineColor": "#cbd5e1",
    "signalColor": "#475569",
    "signalTextColor": "#0f172a",
    "labelBoxBkgColor": "#f1f5f9",
    "labelBoxBorderColor": "#cbd5e1",
    "labelTextColor": "#334155",
    "loopTextColor": "#475569",
    "noteBkgColor": "#fefce8",
    "noteBorderColor": "#fde047",
    "noteTextColor": "#713f12",
    "activationBkgColor": "#e0e7ff",
    "activationBorderColor": "#818cf8",
    "sequenceNumberColor": "#ffffff"
  },
  "flowchart": {
    "curve": "basis",
    "padding": 16,
    "nodeSpacing": 30,
    "rankSpacing": 45,
    "htmlLabels": true,
    "useMaxWidth": true
  },
  "sequence": {
    "mirrorActors": false,
    "showSequenceNumbers": true,
    "actorMargin": 70,
    "width": 200,
    "height": 60,
    "boxMargin": 14,
    "boxTextMargin": 8,
    "noteMargin": 14,
    "messageMargin": 42,
    "wrap": true,
    "useMaxWidth": true,
    "actorFontSize": 15,
    "actorFontWeight": 600,
    "messageFontSize": 15,
    "noteFontSize": 14,
    "noteAlign": "center",
    "messageAlign": "center"
  }
}